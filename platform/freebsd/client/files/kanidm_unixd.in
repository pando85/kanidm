#!/bin/sh
# shellcheck disable=SC1091,SC2034

# PROVIDE: kubidm_unixd
# REQUIRE: LOGIN
# KEYWORD: shutdown
#
# Add these lines to /etc/rc.conf.local or /etc/rc.conf
# to enable this service:
#
# kubidm_unixd_enable (bool):	Set to NO by default.
#				Set it to YES to enable kubidm_unixd.

. /etc/rc.subr

name=kubidm_unixd
rcvar=kubidm_unixd_enable

load_rc_config $name

# shellcheck disable=SC2223
: ${kubidm_unixd_enable:="NO"}

pidfile="/var/run/kubidm-unixd.pid"
command=/usr/sbin/daemon
command_args="-u _kubidm_unixd -p /var/run/kubidm-unixd.pid -T kubidm_unixd /usr/local/libexec/${name}"
procname=/usr/local/libexec/${name}

run_rc_command "$1"
