#!/bin/sh
# shellcheck disable=SC1091,SC2034

# PROVIDE: kubidm_unixd_tasks
# REQUIRE: LOGIN
# KEYWORD: shutdown
#
# Add these lines to /etc/rc.conf.local or /etc/rc.conf
# to enable this service:
#
# kubidm_unixd_tasks_enable (bool):	Set to NO by default.
#				Set it to YES to enable kubidm_unixd_tasks.

. /etc/rc.subr

name=kubidm_unixd_tasks
rcvar=kubidm_unixd_tasks_enable

load_rc_config $name

# shellcheck disable=SC2223
: ${kubidm_unixd_tasks_enable:="NO"}

pidfile="/var/run/kubidm-unixd-tasks.pid"
command=/usr/sbin/daemon
command_args="-u root -p /var/run/kubidm-unixd-tasks.pid -T kubidm_unixd_tasks /usr/local/libexec/${name}"
procname=/usr/local/libexec/${name}

run_rc_command "$1"
