# You should not need to edit this file. Instead, use a drop-in file by running:
#   systemctl edit kubidm-unixd.service

[Unit]
Description=Kubidm Local Client Resolver
After=chronyd.service ntpd.service network-online.target

[Service]
DynamicUser=yes
Type=notify-reload
ExecStart=/usr/local/sbin/kubidm_unixd

CacheDirectory=kubidm-unixd
RuntimeDirectory=kubidm-unixd
UMask=0027

[Install]
WantedBy=multi-user.target