#!/bin/sh
# postinst script for kubidm-unixd
#
# see: dh_installdeb(1)

set -e


case "$1" in
    configure)
        echo "============================="
        echo "Thanks for installing Kubidm!"
        echo "============================="
        echo "Please ensure you modify the configuration files at /etc/kubidm/unixd and /etc/kubidm/config"
        echo "Full examples are in /usr/share/kubidm-unixd/"
        echo "PAM has already been autoconfigured by the libpam-kubidm package. To configure nsswitch, please follow instructions in https://kubidm.github.io/kubidm/master/integrations/pam_and_nsswitch.html"
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0